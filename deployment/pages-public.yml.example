name: Publish public Pages site

'on':
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-node@v7
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: front/package-lock.json
      - name: Check data URL
        env:
          DATA_URL: ${{ vars.R2_PUBLIC_BASE_URL }}
        run: |
          test -n "$DATA_URL"
          case "$DATA_URL" in https://*) ;; *) exit 1 ;; esac
      - name: Install and build
        working-directory: front
        env:
          VITE_BASE_PATH: /SRBench/
          VITE_DATA_BASE_URL: ${{ vars.R2_PUBLIC_BASE_URL }}
        run: |
          npm ci
          npx tsc --noEmit
          npm run build
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v5
        with:
          path: front/dist
      - id: deployment
        uses: actions/deploy-pages@v5
